#!/bin/zsh
# claude-gpt-stdio — non-interactive claude wrapper for t3code's Claude provider.
# Sets gateway env and execs claude with whatever args the Agent SDK passes.
# Unlike ~/.local/bin/claude-gpt: no --model injection, no permission flags —
# t3code's ClaudeAdapter controls those.
export ANTHROPIC_BASE_URL="http://127.0.0.1:8317"
export ANTHROPIC_AUTH_TOKEN="$(cat ~/.cli-proxy-api-key)"
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=372000
exec claude "$@"
