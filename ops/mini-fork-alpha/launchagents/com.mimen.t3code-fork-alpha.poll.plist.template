<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mimen.t3code.fork-alpha.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OPS_ROOT__/scripts/poll.zsh</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
  </array>
  <key>StartInterval</key>
  <integer>__POLL_INTERVAL_SECONDS__</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd-poll.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd-poll.stderr.log</string>
</dict>
</plist>
